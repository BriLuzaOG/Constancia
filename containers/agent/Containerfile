# Agent sandbox: Claude Code on the distro Node, so ecapture can hook its TLS.
FROM registry.fedoraproject.org/fedora:44

# Distro Node links libssl.so.3 dynamically (the nodejs.org binary embeds it).
# nodejs22-full-i18n is only a weak dependency, but without its ICU data
# Intl.Segmenter segfaults and the Claude TUI dies with exit 139.
RUN dnf install -y --setopt=install_weak_deps=False \
        nodejs nodejs22-full-i18n npm bash git which findutils procps-ng ripgrep \
    && dnf clean all

# 2.1.112 is the last JS build. From 2.1.113 on it is a native binary with its
# own TLS stack, invisible to the libssl uprobes.
RUN npm install -g @anthropic-ai/claude-code@2.1.112 && npm cache clean --force

ARG AGENT_UID=1000
RUN useradd --uid "${AGENT_UID}" --create-home agent \
    && install -d -o agent /run/trust

COPY containers/agent/entrypoint.sh /usr/local/bin/agent-entrypoint

ENV DISABLE_AUTOUPDATER=1
USER agent
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/agent-entrypoint"]
