# Kernel witness: bpftrace (probes 1 2 3 5) and ecapture (TLS 4 7).
# Runs privileged with pid: host; see docker-compose.capture.yml.
FROM registry.fedoraproject.org/fedora:44

RUN dnf install -y --setopt=install_weak_deps=False \
        bpftrace jq procps-ng tar gzip \
    && dnf clean all

# The release asset name carries the version: latest/download/... does not resolve.
ARG ECAPTURE_VERSION=2.8.2
RUN curl -fsSL -o /tmp/ecapture.tar.gz \
        "https://github.com/gojue/ecapture/releases/download/v${ECAPTURE_VERSION}/ecapture-v${ECAPTURE_VERSION}-linux-amd64.tar.gz" \
    && tar -xzf /tmp/ecapture.tar.gz -C /tmp \
    && install -m 755 "/tmp/ecapture-v${ECAPTURE_VERSION}-linux-amd64/ecapture" /usr/local/bin/ecapture \
    && rm -rf /tmp/ecapture*

COPY scripts/actions.bt /opt/trust/actions.bt
COPY containers/collector/entrypoint.sh /usr/local/bin/collector-entrypoint

ENTRYPOINT ["/usr/local/bin/collector-entrypoint"]
