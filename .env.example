# Ledger backend: memory (dev, tests) or chain (Sepolia)
LEDGER_MODE=memory
# Sepolia RPC URL, e.g. Alchemy (server only)
LEDGER_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>
# Optional backup Sepolia RPC URL; check:demo verifies both (server only)
LEDGER_RPC_URL_BACKUP=
# Ledger.sol address, 0x + 40 hex. Zero address is a placeholder until the contract is deployed
LEDGER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Block Ledger.sol was deployed at, lower bound for log queries (server only). 0 is a placeholder until deploy
LEDGER_DEPLOY_BLOCK=0
# VerifyingPaymaster address, 0x + 40 hex. Zero address is a placeholder until deploy (server only)
PAYMASTER_ADDRESS=0x0000000000000000000000000000000000000000
# Sponsor EOA private key, 0x + 64 hex (server only). It funds the paymaster's deposit and relays
# every handleOps: fund it from Sepolia faucets (target >= 0.5 ETH)
RELAYER_PRIVATE_KEY=
# Pooled Postgres connection URL (server only)
DATABASE_URL=
# 32+ random bytes, base64 (server only), generated during setup
SESSION_SECRET=
# Public app URL the browser uses, e.g. the Render URL (https://...)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Same mode as LEDGER_MODE, read by the browser
NEXT_PUBLIC_LEDGER_MODE=memory
# Sepolia chain ID
NEXT_PUBLIC_LEDGER_CHAIN_ID=11155111
# ERC-4337 EntryPoint v0.7 canonical address (already deployed on Sepolia; verified on chain)
NEXT_PUBLIC_ENTRY_POINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
# Account factory address, 0x + 40 hex. Zero address is a placeholder until deploy
NEXT_PUBLIC_ACCOUNT_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
# 1 shows the demo identity pages and the operator identity import, 0 hides them
NEXT_PUBLIC_DEMO_MODE=1
