# Public app URL the browser uses, e.g. the Render URL (https://...)
NEXT_PUBLIC_APP_URL=
# Privy app ID from the Privy dashboard
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy app secret (server only)
PRIVY_APP_SECRET=
# Pooled Postgres connection URL (Neon or Render Postgres)
DATABASE_URL=
# Base Sepolia RPC URL: Alchemy, or https://sepolia.base.org (server only)
BASE_SEPOLIA_RPC_URL=
# Same RPC URL, used by the browser for receipt waits
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
# Sponsor wallet private key, 0x + 64 hex (server only, generated after setup)
SPONSOR_PRIVATE_KEY=
# Anchor contract address, 0x + 40 hex. Zero address is a placeholder until A3-S3 deploys
NEXT_PUBLIC_ANCHOR_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Block the anchor contract was deployed at (server only, lower bound for log queries). 0 is a placeholder until A3-S3
ANCHOR_DEPLOY_BLOCK=0
