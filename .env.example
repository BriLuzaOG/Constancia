# Copia este archivo a .env y completa los valores reales.
# .env está en .gitignore y en .dockerignore: nunca se commitea.

# --- Postgres ---
POSTGRES_USER=trust
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trust
POSTGRES_PORT=5432
# Con Podman Compose, el hostname es el nombre del servicio: postgres.
DATABASE_URL=postgresql://trust:change-me@postgres:5432/trust

# --- API ---
API_PORT=3000

# --- Cadena ---
# RPC de la testnet elegida. Probar el faucet antes de la demo.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Wallet que firma el anclaje. NUNCA es la llave de los agentes.
PRIVATE_KEY=0x
CONTRACT_ADDRESS=0x

# --- Anclaje ---
ANCHOR_INTERVAL_MS=300000
BATCH_INTERVAL_MS=30000

# --- Telegram ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
CAS_DIR=/app/data/cas
