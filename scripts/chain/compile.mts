import { mkdirSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { join } from 'node:path';

const require = createRequire(import.meta.url);
const solc = require('solc');

const CONTRACTS_DIR = 'contracts';
const OUT_DIR = join(CONTRACTS_DIR, 'out');
const ABI_FILE = 'src/lib/ledger/abi.ts';
// Un .sol de primer nivel = un contrato desplegable; test/, lib/ y vendor/ solo se importan.
const ABI_EXPORTS: Record<string, string> = {
  ConsortiumAccount: 'consortiumAccountAbi',
  AccountFactory: 'accountFactoryAbi',
  VerifyingPaymaster: 'verifyingPaymasterAbi',
  Ledger: 'ledgerAbi',
};

const sources = Object.fromEntries(
  readdirSync(CONTRACTS_DIR)
    .filter((file) => file.endsWith('.sol'))
    .map((file) => [file, { content: readFileSync(join(CONTRACTS_DIR, file), 'utf8') }]),
);

// shortcut: via-IR is required by the vendored P-256 verifier (stack too deep otherwise); matches foundry.toml.
const input = {
  language: 'Solidity',
  sources,
  settings: {
    evmVersion: 'paris',
    viaIR: true,
    optimizer: { enabled: true, runs: 200 },
    outputSelection: { '*': { '*': ['abi', 'evm.bytecode.object'] } },
  },
};

const output = JSON.parse(
  solc.compile(JSON.stringify(input), {
    import: (path: string) => ({ contents: readFileSync(join(CONTRACTS_DIR, path), 'utf8') }),
  }),
);

const errors = (output.errors ?? []).filter((e: { severity: string }) => e.severity === 'error');
if (errors.length > 0) {
  for (const e of errors) console.error(e.formattedMessage);
  process.exit(1);
}

mkdirSync(OUT_DIR, { recursive: true });
const abis: string[] = [];
for (const [file, contracts] of Object.entries<Record<string, any>>(output.contracts)) {
  for (const [name, artifact] of Object.entries(contracts)) {
    const exportName = ABI_EXPORTS[name];
    if (!exportName || !file.endsWith(`${name}.sol`)) continue;
    writeFileSync(
      join(OUT_DIR, `${name}.json`),
      JSON.stringify({ abi: artifact.abi, bytecode: `0x${artifact.evm.bytecode.object}` }),
    );
    abis.push(`export const ${exportName} = ${JSON.stringify(artifact.abi, null, 2)} as const;\n`);
  }
}

writeFileSync(
  ABI_FILE,
  `// Generated by scripts/chain/compile.ts (pnpm chain:compile). Do not edit.\n\n${abis.join('\n')}`,
);
console.log(`Compiled ${abis.length} contracts -> ${OUT_DIR}, ${ABI_FILE}`);
